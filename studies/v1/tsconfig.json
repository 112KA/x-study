{
  "extends": "@tsconfig/vite-react/tsconfig.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "ES2015",
    "moduleResolution": "bundler",
    "paths": {
      "x3/*": ["./x3_src/*"],
      "x3-controls/*": ["./x3-controls_src/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client"]
  }
}
